// Cognix settings
//
// To see all of Cognix's default settings without changing your
// custom settings, run `cognix: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
   "cognix.glm": {
      "api_url": "https://glm.cognix.sryze.cc"
   },
   "nim": {
      "api_url": "https://integrate.api.nvidia.com",
       "nim_filter_url": "https://raw.githubusercontent.com/izaart95-jpg/cognix/refs/heads/main/nvidia_model_filter"
    }
  },
  "title_bar": {
    "show_sign_in": false
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
}
